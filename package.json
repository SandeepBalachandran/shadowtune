{
  "name": "shadowtune",
  "productName": "ShadowTune",
  "version": "0.1.0",
  "description": "Unofficial Windows desktop configurator for the EvoFox Shadow X Pro mouse",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "probe": "node scripts/probe.mjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "koffi": "2.9.0",
    "node-hid": "3.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.3.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "rcedit": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.1.11",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "electron@33.3.1": true,
    "esbuild@0.21.5": true,
    "node-hid@3.1.2": true,
    "@tailwindcss/oxide@4.1.11": true
  }
}
